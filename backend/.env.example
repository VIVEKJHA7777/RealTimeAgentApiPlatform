# Copy this file to .env and fill in real values.
# development | production | test
NODE_ENV=development
# Port the Express server listens on
PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://api_platform:change_me@localhost:5432/api_platform_dev"

# ── Data uploads (all optional; these are the defaults) ──
# Largest upload in MB
UPLOAD_MAX_MB=200
# Folder for uploaded files waiting to be read (default: the system temp folder)
# UPLOAD_TMP_DIR=/tmp/api-platform-uploads
# Most rows / columns per data source
IMPORT_MAX_ROWS=1000000
IMPORT_MAX_COLUMNS=200
# Imports running at the same time
IMPORT_CONCURRENCY=2
# CSV downloads streaming at the same time (more → 429, try again)
DOWNLOAD_CONCURRENCY=4
# Design value checks (each reads every row of a data source) at the same time; more → 429
VALUE_CHECK_CONCURRENCY=4

# Database connections the app keeps (default 10; Postgres allows 100 for everything)
DB_POOL_MAX=10

# ── API tokens (Phase 4) ──
# REQUIRED. Encrypts the stored copy of API tokens so owners can view them again.
# Make one with: openssl rand -base64 32   (keep it secret; changing it means old tokens
# still work but can't be shown any more)
TOKEN_ENCRYPTION_KEY=
# Address Jivox uses to reach this server, shown in curl (default http://localhost:<PORT>)
# PUBLIC_BASE_URL=https://abc123.ngrok.app

# ── Running on a server (task 6.0; see docs/DEPLOY-render-neon.md) ──
# Who may create an account. Not set: anyone in development, NOBODY in production.
# "*" = anyone; or emails and "@domain" endings, comma-separated:
# SIGNUP_ALLOWED_EMAILS=you@jivox.com,@jivox.com
# Login + sign-up attempts per IP per 15 min (default: 0 = off in development, 30 in production)
# AUTH_ATTEMPTS_PER_15_MIN=30
# Proxies in front of the app (Render: 1), so the caller's real IP is used. Local: 0
# TRUST_PROXY=0
# The built frontend served by the backend (production does this by itself from ../frontend/dist)
# FRONTEND_DIST=../frontend/dist
# Jivox MCP hosts this server may WRITE to (submit / activate), comma-separated. Not set = any host.
# JIVOX_WRITE_HOSTS=brandstore-data-mcp.qa3.jivox.com
